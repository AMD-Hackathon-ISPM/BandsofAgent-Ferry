# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ferry
DB_USER=ferry
DB_PASSWORD=ferry_dev_password
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ferry
MINIO_SECRET_KEY=ferry_dev_password
MINIO_USE_SSL=false
MINIO_BUCKET_SOURCE=ferry-source-files
MINIO_BUCKET_ARTIFACTS=ferry-artifacts
MINIO_BUCKET_REPORTS=ferry-reports
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
BAND_PROVIDER=stub
BAND_BASE_URL=https://api.band.dev/v1
BAND_API_KEY=your_band_api_key_here
MODEL_PROVIDER=featherless
MODEL_API_KEY=your_model_api_key_here
MODEL_NAME=meta-llama/Meta-Llama-3.1-70B-Instruct
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096
MODEL_ENDPOINT=
GITHUB_PAT=your_github_personal_access_token_here
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_UPLOAD=50
MAX_CONCURRENT_MIGRATIONS=5
MIGRATION_TIMEOUT_MINUTES=30
AUDIT_LOG_RETENTION_DAYS=365
ENABLE_DB_MIGRATION=true
ENABLE_GITHUB_INTEGRATION=true
ENABLE_REAL_BAND=false