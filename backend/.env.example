PORT=8080
ENV=development
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ferry
DB_USER=ferry
DB_PASSWORD=
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ferry
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET_SOURCE=ferry-source-files
MINIO_BUCKET_ARTIFACTS=ferry-artifacts
MINIO_BUCKET_REPORTS=ferry-reports

JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback

# GitHub App identity — used to mint short-lived, per-repo installation tokens
# so PRs push with the user's installed App (no PATs). APP_ID is the numeric id
# from the App settings; APP_SLUG is the name in github.com/apps/<slug>.
# Configure the App with Contents + Pull requests = Read/write, and set its
# "Setup URL" to <backend>/auth/github/setup.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Private key — pick ONE:
#  (A) easiest: drop the downloaded .pem next to this file and point to it.
#      In Docker, mount it and use the in-container path (see docker-compose).
GITHUB_APP_PRIVATE_KEY_PATH=
#  (B) inline: the .pem as a single line with literal \n between lines.
GITHUB_APP_PRIVATE_KEY=

# Optional fallback only: a classic PAT with `repo` scope, used if no GitHub App
# installation token and no user login token can write. Leave empty in prod.
GITHUB_PAT=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

LOG_LEVEL=info
LOG_FORMAT=json

BAND_PROVIDER=stub
BAND_BASE_URL=https://app.band.ai/api/v1
BAND_API_KEY=
BAND_AGENT_NAMESPACE=dxs16823

BAND_ROUTER_ID=
BAND_ROUTER_KEY=
BAND_COMMANDER_ID=
BAND_COMMANDER_KEY=
BAND_TEST_GENERATOR_ID=
BAND_TEST_GENERATOR_KEY=
BAND_GITHUB_CONNECTOR_ID=
BAND_GITHUB_CONNECTOR_KEY=
BAND_SOURCE_ANALYZER_ID=
BAND_SOURCE_ANALYZER_KEY=
BAND_BUSINESS_LOGIC_ID=
BAND_BUSINESS_LOGIC_KEY=
BAND_CODE_GENERATOR_ID=
BAND_CODE_GENERATOR_KEY=
BAND_DB_MIGRATION_ID=
BAND_DB_MIGRATION_KEY=
BAND_REVIEWER_ID=
BAND_REVIEWER_KEY=

AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_KEY=

FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_KEY=

# Max simultaneous LLM requests across ALL agents. Keep at/below the tightest
# provider concurrency cap (e.g. Featherless reasoning models = 2 concurrent on
# pro_plus). Agents also back off + retry on 429.
LLM_MAX_CONCURRENCY=2

AGENT_ROUTER_MODEL=deepseek/deepseek-chat-v3.1
AGENT_ROUTER_SOURCE=aimlapi

AGENT_COMMANDER_MODEL=deepseek/deepseek-chat-v3.1
AGENT_COMMANDER_SOURCE=aimlapi

AGENT_TEST_GENERATOR_MODEL=deepseek/deepseek-chat-v3.1
AGENT_TEST_GENERATOR_SOURCE=aimlapi

AGENT_GITHUB_CONNECTOR_MODEL=deepseek/deepseek-chat-v3.1
AGENT_GITHUB_CONNECTOR_SOURCE=aimlapi

AGENT_SOURCE_ANALYZER_MODEL=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled
AGENT_SOURCE_ANALYZER_SOURCE=featherless

AGENT_BUSINESS_LOGIC_MODEL=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled
AGENT_BUSINESS_LOGIC_SOURCE=featherless

AGENT_CODE_GENERATOR_MODEL=Qwen/Qwen3-Coder-Next
AGENT_CODE_GENERATOR_SOURCE=featherless
AGENT_CODE_GENERATOR_GO_MODEL=Qwen/Qwen3-Coder-Next
AGENT_CODE_GENERATOR_GO_SOURCE=featherless
AGENT_CODE_GENERATOR_RUST_MODEL=Fortytwo-Network/Strand-Rust-Coder-14B-v1
AGENT_CODE_GENERATOR_RUST_SOURCE=featherless

AGENT_DB_MIGRATION_MODEL=Qwen/Qwen3-Coder-Next
AGENT_DB_MIGRATION_SOURCE=featherless

AGENT_REVIEWER_MODEL=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled
AGENT_REVIEWER_SOURCE=featherless

ENABLE_DB_MIGRATION=true
ENABLE_GITHUB_INTEGRATION=true
ENABLE_REAL_BAND=false
# Reviewer/Test agents compile + run generated code in the sandbox runner.
ENABLE_CODE_EXECUTION=false
# Runner microservice URL (the only service with Docker access). Empty = run
# Docker locally in-process. In compose this is set to http://runner:9090.
RUNNER_URL=
# Sandbox container runtime, set on the RUNNER service: "" = runc (dev),
# "runsc" = gVisor, "kata-runtime"/"kata" = Kata microVMs (prod).
SANDBOX_RUNTIME=
