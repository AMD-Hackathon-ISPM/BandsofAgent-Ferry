# =============================================================================
# Ferry Backend — Environment Variables
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.
# =============================================================================

# Server
PORT=8080
ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ferry
DB_USER=ferry
DB_PASSWORD=
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ferry
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET_SOURCE=ferry-source-files
MINIO_BUCKET_ARTIFACTS=ferry-artifacts
MINIO_BUCKET_REPORTS=ferry-reports

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# GitHub OAuth app (create one at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback
GITHUB_PAT=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Band / agent orchestrator
BAND_PROVIDER=stub
BAND_BASE_URL=
BAND_API_KEY=

# =============================================================================
# API Sources
# Two OpenAI-compatible gateways. Set the key for whichever you use.
# =============================================================================


AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_KEY=

FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_KEY=

# =============================================================================
# Per-agent model configuration
#
# _MODEL  = model id passed to /v1/chat/completions
# _SOURCE = which gateway: "aimlapi" or "featherless"
#
# Non-volatile agents (routing, coordination, file ops) → cheap DeepSeek
# Pivotal agents (analysis, generation, review)         → reasoning model
# =============================================================================

# --- Non-volatile (cheap) ---
AGENT_ROUTER_MODEL=deepseek/deepseek-chat-v3.1
AGENT_ROUTER_SOURCE=aimlapi

AGENT_COMMANDER_MODEL=deepseek/deepseek-chat-v3.1
AGENT_COMMANDER_SOURCE=aimlapi

AGENT_TEST_GENERATOR_MODEL=deepseek/deepseek-chat-v3.1
AGENT_TEST_GENERATOR_SOURCE=aimlapi

AGENT_GITHUB_CONNECTOR_MODEL=deepseek/deepseek-chat-v3.1
AGENT_GITHUB_CONNECTOR_SOURCE=aimlapi

# --- Pivotal (reasoning) ---
AGENT_SOURCE_ANALYZER_MODEL=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled
AGENT_SOURCE_ANALYZER_SOURCE=featherless

AGENT_BUSINESS_LOGIC_MODEL=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled
AGENT_BUSINESS_LOGIC_SOURCE=featherless

AGENT_CODE_GENERATOR_MODEL=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled
AGENT_CODE_GENERATOR_SOURCE=featherless

AGENT_DB_MIGRATION_MODEL=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled
AGENT_DB_MIGRATION_SOURCE=featherless

AGENT_REVIEWER_MODEL=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled
AGENT_REVIEWER_SOURCE=featherless

# =============================================================================
# Feature flags
# =============================================================================
ENABLE_DB_MIGRATION=true
ENABLE_GITHUB_INTEGRATION=true
ENABLE_REAL_BAND=false
